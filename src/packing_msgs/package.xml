<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>packing_msgs</name>
  <version>0.1.0</version>
  <description>
    Project Palletris 팀 공용 인터페이스 정의 (메시지 6 + 서비스 15).
    필드 이름이 곧 팀의 계약이다 — 임의로 바꾸지 않는다.
    수정은 반드시 main 에 먼저 머지하고 전원 pull.
  </description>
  <maintainer email="jungji0913@khu.ac.kr">Project Palletris</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ★ 아래 3줄이 없으면 .msg/.srv 에서 파이썬 클래스가 생성되지 않는다 -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ZoneStatus.msg 가 builtin_interfaces/Time 을 쓴다 -->
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
