<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>packing_msgs</name>
  <version>0.0.0</version>
  <description>
    ★ 초안 (트랙 C 정정인이 통합 시연을 위해 먼저 작성). 정본 소유는 트랙 D 민범진.
    필드 이름·타입은 작업명세서 §2.1 / §2.2 를 한 글자도 바꾸지 않고 옮긴 것이며,
    srv 파일 이름만 제안값이다. 철칙 1 에 따라 반드시 main 에 먼저 머지하고 전원이 pull 한다.
  </description>
  <maintainer email="jungji0913@khu.ac.kr">정정인 (초안 · 인수인계 대상: 민범진)</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>          <!-- BoxAtPickup.msg 의 Pose -->

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export><build_type>ament_cmake</build_type></export>
</package>
