<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>packing_msgs</name>
  <version>0.1.0</version>
  <description>
    ROS 2 공용 인터페이스. 필드 이름·타입은 **CLAUDE.md §3 을 한 글자도 바꾸지 않고**
    옮긴 것이다. 여기를 고치면 팀 4명 전원이 재빌드해야 한다 (§11·§14).
    2026-08-24 §3 최종본에 맞춰 정렬 — RobotCmd·RobotEvent 신규, BoxAtPickup 이 Pose 를
    버리고 mm 정수로, BoxInfo·ZoneStatus 필드 확정, ResetZone -> ResetHeightmap,
    UpdateHeightmap 응답에 max_height_mm 추가.
  </description>
  <maintainer email="jungji0913@khu.ac.kr">Project Palletris</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ★ 아래 3줄이 없으면 .msg/.srv 에서 파이썬 클래스가 생성되지 않는다 -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ZoneStatus.msg 가 builtin_interfaces/Time 을 쓴다 -->
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
