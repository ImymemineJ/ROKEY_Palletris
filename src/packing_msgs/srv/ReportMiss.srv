# 인식 노드 → db.  **박스를 봤는데 식별하지 못했다**를 알린다.
#
# ★ 왜 필요한가 — 인식률의 분모 때문이다.
#   분모를 boxes_sorted(등록된 박스)로 잡으면 놓친 박스는 애초에 안 세어져
#   인식률이 **언제나 100 %** 로 나온다.
#   분모를 boxes_master(정답지 풀)로 잡으면 풀을 넉넉히 깔수록 인식률이
#   낮게 나온다 — 거꾸로 된 지표다. 실측: 풀 105 개에 15 개만 흘렸더니 14 % 였다.
#   맞는 분모는 **라인에 실제로 올라온 박스 수**이고, 그건 cam1 만 안다.
#   QR 을 못 읽어도 "빨간 덩어리가 지나갔다"는 것은 보이기 때문이다.
#
#   등록에 성공한 박스는 RegisterBox 가 이미 세므로 여기로는 **실패만** 보낸다.
#       분모 = 등록 성공 + 여기로 온 실패
#
# ★ box_id 를 받지 않는다. 식별에 실패했으니 있을 리가 없다.
#   지어내서 넣으면 남의 박스 기록을 덮는다.

string  where_at     # "cam1" | "cam2" | "pick_cam"
string  reason       # "QR_UNREADABLE" | "SIZE_MISMATCH" | "CLIPPED" | "NO_CAMERA_INFO"
---
bool    ok
int32   miss_count   # 그 지점의 누적 실패 수 (로그·디버깅용)
