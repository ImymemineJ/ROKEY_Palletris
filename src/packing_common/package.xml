<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>packing_common</name>
  <version>0.0.0</version>
  <description>
    전원이 공유하는 단위 변환(units) · 팔레트 좌표계 변환(frames) · config 로더.
    ROS 의존성이 없어 Isaac 쪽 프로세스에서도 그대로 import 할 수 있다. (작업명세서 §1.3, §3.3)
  </description>
  <maintainer email="jungji0913@khu.ac.kr">정정인</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-yaml</exec_depend>
  <!-- ★ paths.py 가 share 경로를 물을 때만 쓴다. 순수 파이썬이라 rclpy 를 안 끌어온다.
       ROS 없는 환경(Isaac 내장 파이썬 · 맨 scripts)에서도 import 가 살아 있도록
       paths.py 는 이걸 **함수 안에서 try/except 로만** 부른다. -->
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
